# Database Configuration
DATABASE_URL="mysql://USER:PASSWORD@localhost:3307/sdp_db"

# JWT Configuration
JWT_ACCESS_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
JWT_EXPIRES_IN="24h"

# Server Configuration
PORT=5000

# File Upload Configuration
MAX_FILE_SIZE=5000000
UPLOAD_PATH="./uploads"

# CORS Configuration
CORS_ORIGIN="http://localhost:5173"

# Frontend API base URL (if used by your local tooling)
VITE_API_URL=http://localhost:5000/api

# SMTP (email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER="your-email@example.com"
SMTP_PASS="YOUR_SMTP_PASSWORD_OR_APP_PASSWORD"
SENDER_NAME="Your Company"

# Email mode (comma-separated supported values: console,smtp)
EMAIL_MODE="console"

# Brevo SMTP (optional)
# BREVO_SMTP_HOST=smtp-relay.brevo.com
# BREVO_SMTP_PORT=587
# BREVO_SMTP_USER=your-brevo-user
# BREVO_SMTP_PASS=your-brevo-pass
# BREVO_SENDER_EMAIL=sender@example.com
# BREVO_SENDER_NAME="SDP"

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=YOUR_GMAIL_APP_PASSWORD
